---
// Alap oldalváz: minden oldal ezt használja.
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/montserrat/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title?: string; description?: string; image?: string }
const { title, description = 'A Magvető Kiadó honlapjának koncepcióterve.', image } = Astro.props;
const full = title ? `${title} – Magvető Kiadó (koncepció)` : 'Magvető Kiadó (koncepció)';
---
<!doctype html>
<html lang="hu">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  {image && <meta property="og:image" content={image} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#F5F1E8" />
</head>
<body>
  <a class="skip" href="#tartalom">Ugrás a tartalomra</a>
  <aside class="concept" aria-label="Figyelmeztetés">Koncepcióterv – nem hivatalos oldal. A tartalom forrása: magveto.hu</aside>
  <Header />
  <main id="tartalom" tabindex="-1"><slot /></main>
  <Footer />
</body>
</html>
<style is:global>
  .skip { position: absolute; left: 12px; top: -60px; z-index: 100; background: var(--c-ink); color: var(--c-paper); padding: 10px 14px; font: 600 var(--t-small)/1 var(--f-sans); }
  .skip:focus { top: 12px; }
  .concept { background: var(--c-ink); color: var(--c-paper); text-align: center; font: 500 var(--t-micro)/1.3 var(--f-sans); padding: 7px var(--gutter); letter-spacing: .02em; }
  main:focus { outline: none; }
</style>
