---
// Sajtószoba (IA 4.7): a legfrissebb 50 sajtótétel, keresés és forrás szerinti szűrés, sajtókapcsolat.
import Base from '../../layouts/Base.astro';
import Mail from '../../components/Mail.astro';
import { press, bookById } from '../../lib/data';
import { pressContacts, telHref } from '../../lib/contact';
import { huDate, fold, collator } from '../../lib/text';
const sources = [...new Set(press.map((p) => p.source).filter(Boolean))].sort((a, b) => collator.compare(a, b));
---
<Base title="Sajtószoba" description="A Magvető könyveiről megjelent sajtóanyagok és a sajtókapcsolat.">
  <div class="wrap pg">
    <header><h1 class="pg__h1">Sajtószoba</h1><p class="meta">A Magvető könyveiről megjelent kritikák, interjúk és cikkek – a legfrissebb {press.length} tétel.</p></header>
    <div class="layout">
      <div>
        <form class="flt" role="search" aria-label="Keresés a sajtószobában" onsubmit="return false">
          <div><label for="sq" class="lbl">Keresés a sajtószobában</label><input id="sq" type="search" placeholder="Cím, forrás vagy könyv" data-q /></div>
          <div><label for="ss" class="lbl">Forrás</label>
            <select id="ss" data-src><option value="">Minden forrás</option>{sources.map((s) => <option value={s}>{s}</option>)}</select></div>
        </form>
        <p class="meta" aria-live="polite" data-count>{press.length} tétel</p>
        <ul class="pl" role="list">
          {press.map((p) => {
            const b = p.bookId ? bookById.get(p.bookId) : undefined;
            return (
              <li class="pi" data-src={p.source} data-text={fold(`${p.title} ${p.source} ${b?.title ?? p.bookTitle} ${b?.authors.map((a) => a.name).join(' ') ?? ''}`)}>
                <div>
                  <p class="pi__m"><time datetime={p.date}>{huDate(p.date)}</time>{p.source && <> · {p.source}</>}</p>
                  <h2 class="pi__t"><a href={`/sajtoszoba/${p.slug}`}>{p.title}</a></h2>
                  {b && <p class="pi__b">Kiadvány: <a href={`/konyvek/${b.slug}`}>{b.title}</a>{b.authors[0] && ` – ${b.authors.map((a) => a.name).join(', ')}`}</p>}
                </div>
                {b?.cover && <a href={`/konyvek/${b.slug}`} tabindex="-1" aria-hidden="true" class="pi__c"><img src={b.cover.thumb} alt="" width="64" height="96" loading="lazy" /></a>}
              </li>
            );
          })}
        </ul>
        <p class="meta" data-empty hidden>Nincs a szűrésnek megfelelő tétel.</p>
      </div>
      <aside class="contact" aria-labelledby="sk">
        <h2 id="sk" class="contact__h">Sajtókapcsolat</h2>
        <p class="meta">PR és marketing</p>
        {pressContacts.map((c) => (
          <div class="contact__p">
            <p class="contact__n">{c.name}</p>
            {c.phone && <p><a href={`tel:${telHref(c.phone)}`}>{c.phone}</a></p>}
            {c.mail && <p><Mail mail={c.mail} /></p>}
          </div>
        ))}
        <a class="sec__more" href="/kapcsolat">Minden elérhetőség →</a>
      </aside>
    </div>
  </div>
</Base>
<script>
  const q = document.querySelector<HTMLInputElement>('[data-q]')!;
  const src = document.querySelector<HTMLSelectElement>('[data-src]')!;
  const items = Array.from(document.querySelectorAll<HTMLElement>('.pi'));
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const fold = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  function apply() {
    const t = fold(q.value.trim()); const s = src.value; let n = 0;
    for (const li of items) { const ok = (!t || li.dataset.text!.includes(t)) && (!s || li.dataset.src === s); li.hidden = !ok; if (ok) n++; }
    count.textContent = `${n} tétel`; empty.hidden = n > 0;
  }
  q.addEventListener('input', apply); src.addEventListener('change', apply);
</script>
<style>
  .pg { padding-top: var(--s-7); }
  .pg__h1 { font-size: var(--t-h1); margin-bottom: var(--s-2); }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: var(--s-7); margin-top: var(--s-6); align-items: start; }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } }
  .flt { display: grid; grid-template-columns: 1fr 220px; gap: var(--s-3); margin-bottom: var(--s-3); }
  @media (max-width: 600px) { .flt { grid-template-columns: 1fr; } }
  .lbl { display: block; font: 600 var(--t-micro)/1 var(--f-sans); letter-spacing: .06em; text-transform: uppercase; color: var(--c-graphite); margin-bottom: 6px; }
  .flt input, .flt select { width: 100%; min-height: 44px; padding: 0 12px; border: 1.5px solid var(--c-control); border-radius: var(--radius); background: var(--c-sheet); font: 400 var(--t-small)/1 var(--f-sans); }
  .flt input:focus, .flt select:focus { outline: none; border-color: var(--c-seal); box-shadow: 0 0 0 3px #EBD3C9; }
  .pl { list-style: none; padding: 0; margin: var(--s-3) 0 0; border-top: var(--rule-strong); }
  .pi { display: grid; grid-template-columns: 1fr auto; gap: var(--s-4); padding: var(--s-4) 0; border-bottom: var(--rule); }
  .pi__m { margin: 0; font: 600 var(--t-micro)/1.3 var(--f-sans); color: var(--c-graphite); }
  .pi__t { font-size: 1.25rem; line-height: 1.25; margin: 4px 0; }
  .pi__t a { text-decoration: none; } .pi__t a:hover { text-decoration: underline; }
  .pi__b { margin: 0; font-size: var(--t-small); color: var(--c-graphite); }
  .pi__c img { width: 64px; height: auto; box-shadow: var(--shadow-cover); }
  .contact { position: sticky; top: var(--s-5); background: var(--c-sheet); border: var(--rule); padding: var(--s-5); }
  .contact__h { font-size: var(--t-h3); margin-bottom: var(--s-2); }
  .contact__p { padding: var(--s-3) 0; border-bottom: var(--rule); font: 400 var(--t-small)/1.5 var(--f-sans); }
  .contact__p p { margin: 0; }
  .contact__n { font-weight: 600; }
  .contact .sec__more { display: inline-block; margin-top: var(--s-4); }
</style>
