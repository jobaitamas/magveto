---
import Base from '../layouts/Base.astro';
---
<Base title="Az oldal nem található">
  <div class="wrap pg">
    <p class="eyebrow">404</p>
    <h1 class="pg__h1">Ez az oldal nem található</h1>
    <p>Lehet, hogy elírás van a címben, vagy az oldal nem része ennek a koncepciótervnek.</p>
    <p><a class="btn" href="/">Vissza a kezdőlapra</a> <a class="btn btn--ghost" href="/kiadvanyok">Kiadványok</a></p>
  </div>
</Base>
<style>.pg { padding: var(--s-8) 0; } .pg__h1 { font-size: var(--t-h1); margin: var(--s-2) 0 var(--s-4); }</style>
