---
// Szerző aloldal (IA 4.5).
import Base from '../../layouts/Base.astro';
import BookCard from '../../components/BookCard.astro';
import { authors, bookById, pressForAuthor, type Author } from '../../lib/data';
import { huDate, stripHtml, excerpt } from '../../lib/text';
export function getStaticPaths() { return authors.map((a) => ({ params: { slug: a.slug }, props: { author: a } })); }
const { author: a } = Astro.props as { author: Author };
const works = a.workIds.map((id) => bookById.get(id)!).filter(Boolean);
const pressItems = pressForAuthor(a);
// A bio első sora gyakran a „Fotó: …” forrásjelölés – ezt a fotó alá tesszük
let bio = a.bioHtml;
let credit: string | null = null;
const m = bio.match(/<p>\s*(Fotó:[^<]*)(<br\s*\/?>)?\s*<\/p>/i);
if (m) { credit = m[1].trim(); bio = bio.replace(m[0], ''); }
const initials = a.name.split(/\s+/).filter((w) => /^[A-ZÁÉÍÓÖŐÚÜŰ]/.test(w)).map((w) => w[0]).slice(0, 2).join('');
const desc = excerpt(a.short || stripHtml(bio), 155) || undefined;
---
<Base title={a.name} description={desc} image={a.photo?.src}>
  <div class="wrap">
    <nav class="crumb" aria-label="Morzsamenü"><ol><li><a href="/">Kezdőlap</a></li><li><a href="/szerzok">Szerzők</a></li><li aria-current="page">{a.name}</li></ol></nav>
    <article class="au">
      <figure class="au__fig">
        {a.photo ? <img src={a.photo.src} alt={`${a.name} portréja`} width={a.photo.w ?? 600} height={a.photo.h ?? 800} /> : <span class="au__mono" aria-hidden="true">{initials}</span>}
        {credit && <figcaption class="meta">{credit}</figcaption>}
      </figure>
      <div class="au__main">
        <h1 class="au__name">{a.name}</h1>
        {a.years && <p class="au__years">{a.years}</p>}
        {a.short && <p class="au__short">{a.short}</p>}
        {bio && <div class="prose au__bio" set:html={bio} />}
        {!a.short && !bio && <p class="meta">A szerzőhöz nem tartozik bemutatás a kiadó oldalán.</p>}
      </div>
    </article>
  </div>

  <section class="wrap sec" aria-labelledby="muvei">
    <div class="sec__head"><h2 id="muvei">Művei a Magvetőnél <span class="muted cnt">({works.length + a.untrackedWorks.length})</span></h2></div>
    {works.length ? <ul class="grid-books" role="list">{works.map((b) => <li><BookCard book={b} showPrice /></li>)}</ul>
      : <p class="meta">A kiadó oldalán ehhez a szerzőhöz nem tartozik műlista.</p>}
    {a.untrackedWorks.length > 0 && (
      <div class="untr"><h3 class="meta">További művek (adatlap nélkül)</h3><ul>{a.untrackedWorks.map((t) => <li>{t}</li>)}</ul></div>
    )}
  </section>

  {pressItems.length > 0 && (
    <section class="wrap sec" aria-labelledby="sajto">
      <div class="sec__head"><h2 id="sajto">Sajtóvisszhang</h2><a class="sec__more" href="/sajtoszoba">Sajtószoba →</a></div>
      <ul class="pl" role="list">
        {pressItems.map((p) => <li><p class="pl__m">{p.source} · {huDate(p.date)}{p.bookId && <> · <i>{bookById.get(p.bookId)?.title}</i></>}</p><a class="pl__t" href={`/sajtoszoba/${p.slug}`}>{p.title}</a></li>)}
      </ul>
    </section>
  )}
</Base>
<style>
  .au { display: grid; grid-template-columns: minmax(180px, 320px) minmax(0, 1fr); gap: clamp(24px, 5vw, 64px); align-items: start; }
  .au__fig { margin: 0; }
  .au__fig img { width: 100%; aspect-ratio: 3/4; object-fit: cover; background: var(--c-shade); }
  .au__fig figcaption { margin-top: var(--s-2); }
  .au__mono { display: grid; place-items: center; width: 100%; aspect-ratio: 3/4; background: var(--c-sheet); border: 1px solid var(--c-margin); font: 500 clamp(3rem, 6vw, 5rem)/1 var(--f-serif); color: var(--c-graphite); }
  .au__name { font-size: var(--t-display); line-height: 1.02; }
  .au__years { font: 500 var(--t-small)/1 var(--f-sans); color: var(--c-graphite); margin: var(--s-3) 0 0; }
  .au__short { font-size: var(--t-lead); line-height: 1.5; margin: var(--s-5) 0; max-width: 56ch; }
  .au__bio :global(p) { margin-bottom: .8em; }
  @media (max-width: 760px) { .au { grid-template-columns: 1fr; } .au__fig { max-width: 240px; } }
  .cnt { font-size: .7em; }
  .untr { margin-top: var(--s-6); } .untr ul { margin: var(--s-2) 0 0; padding-left: 1.2em; }
  .pl { list-style: none; padding: 0; margin: 0; }
  .pl li { padding: var(--s-3) 0; border-bottom: var(--rule); }
  .pl__m { margin: 0; font: 600 var(--t-micro)/1.3 var(--f-sans); color: var(--c-graphite); }
  .pl__t { font-size: 1.125rem; text-decoration: none; } .pl__t:hover { text-decoration: underline; }
</style>
