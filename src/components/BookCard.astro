---
// Könyvkártya – az egyetlen könyv-kártyatípus az egész oldalon (következetesség).
import type { Book } from '../lib/data';
import Cover from './Cover.astro';
import { price, huDate } from '../lib/text';
interface Props { book: Book; showPrice?: boolean; headingLevel?: 'h2' | 'h3' | 'h4' }
const { book, showPrice = false, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<article class="bc">
  <a class="bc__link" href={`/konyvek/${book.slug}`}>
    <Cover book={book} />
    <H class="bc__t">{book.title}</H>
  </a>
  {book.authors.length > 0 && <p class="bc__a">{book.authors.map((a) => a.name).join(', ')}</p>}
  {book.subtitle && <p class="bc__s">{book.subtitle}</p>}
  {book.forthcoming && <p class="bc__f">Előkészületben{book.expected ? ` · ${huDate(book.expected)}` : ''}</p>}
  {showPrice && !book.forthcoming && book.price && <p class="bc__p">{price(book.price)}</p>}
</article>
