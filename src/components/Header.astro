---
// Fejléc: logó, fő menü (4 pont), mindig látható kereső javaslatlistával.
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const nav = [
  { href: '/kiadvanyok', label: 'Kiadványok', match: ['/kiadvanyok', '/konyvek', '/kategoriak'] },
  { href: '/szerzok', label: 'Szerzők', match: ['/szerzok'] },
  { href: '/sajtoszoba', label: 'Sajtószoba', match: ['/sajtoszoba'] },
  { href: '/kapcsolat', label: 'Kapcsolat', match: ['/kapcsolat'] },
];
const q = Astro.url.searchParams?.get?.('q') ?? '';
---
<header class="hd">
  <div class="wrap hd__in">
    <a class="hd__logo" href="/" aria-label="Magvető Kiadó – kezdőlap"><Logo size={38} /></a>
    <button class="hd__menu" type="button" aria-expanded="false" aria-controls="fomenu">
      <span aria-hidden="true" class="hd__burger"></span><span class="hd__menutxt">Menü</span>
    </button>
    <nav id="fomenu" class="hd__nav" aria-label="Fő navigáció">
      <ul>
        {nav.map((n) => {
          const active = n.match.some((m) => path === m || path.startsWith(m + '/'));
          return <li><a href={n.href} aria-current={active ? 'page' : undefined}>{n.label}</a></li>;
        })}
      </ul>
    </nav>
    <form class="hd__search" role="search" action="/kereses" method="get" data-search>
      <label class="sr-only" for="q">Keresés szerzőre, címre, ISBN-re</label>
      <svg class="hd__icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <input id="q" name="q" type="search" value={q} autocomplete="off" spellcheck="false" placeholder="Keresés szerzőre, címre…"
             role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="q-list" />
      <div class="hd__pop" id="q-pop" hidden>
        <ul id="q-list" role="listbox" aria-label="Javaslatok"></ul>
        <a class="hd__all" href="/kereses" data-all>Összes találat</a>
      </div>
      <p class="sr-only" aria-live="polite" data-status></p>
    </form>
  </div>
</header>

<script>
  import { initSearchBox } from '../scripts/search';
  initSearchBox();
  const btn = document.querySelector<HTMLButtonElement>('.hd__menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    document.documentElement.classList.toggle('menu-open', !open);
  });
</script>

<style>
  .hd { background: var(--c-paper); border-bottom: var(--rule); position: relative; z-index: 20; }
  .hd__in { display: flex; align-items: center; gap: var(--s-6); min-height: 76px; }
  .hd__logo { text-decoration: none; flex: none; }
  .hd__nav ul { display: flex; gap: var(--s-5); list-style: none; margin: 0; padding: 0; }
  .hd__nav a { font: 500 var(--t-small)/1 var(--f-sans); text-decoration: none; padding: 10px 0; display: inline-block; border-bottom: 2px solid transparent; }
  .hd__nav a:hover { color: var(--c-seal); }
  .hd__nav a[aria-current="page"] { border-bottom-color: var(--c-seal); }
  .hd__search { position: relative; margin-left: auto; width: min(340px, 100%); }
  .hd__icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--c-graphite); pointer-events: none; }
  .hd__search input { width: 100%; height: 44px; padding: 0 12px 0 38px; background: var(--c-sheet); border: 1.5px solid var(--c-control); border-radius: var(--radius); font: 400 var(--t-small)/1 var(--f-sans); }
  .hd__search input::placeholder { color: var(--c-graphite); opacity: 1; }
  .hd__search input:focus { outline: none; border-color: var(--c-seal); box-shadow: 0 0 0 3px #EBD3C9; }
  .hd__pop { position: absolute; top: calc(100% + 6px); right: 0; width: min(440px, 92vw); background: var(--c-sheet); border: 1px solid var(--c-margin); box-shadow: 0 20px 40px -20px rgba(27,26,23,.35); padding: var(--s-2) 0; }
  .hd__pop :global(ul) { list-style: none; margin: 0; padding: 0; }
  .hd__pop :global(.grp) { font: 600 11px/1 var(--f-sans); letter-spacing: .08em; text-transform: uppercase; color: var(--c-graphite); padding: 12px 16px 6px; }
  .hd__pop :global([role="option"]) { display: flex; gap: 12px; align-items: center; padding: 8px 16px; cursor: pointer; text-decoration: none; }
  .hd__pop :global([role="option"][aria-selected="true"]), .hd__pop :global([role="option"]:hover) { background: var(--c-shade); }
  .hd__pop :global(.opt-img) { width: 32px; flex: none; aspect-ratio: 2/3; object-fit: cover; background: var(--c-shade); }
  .hd__pop :global(.opt-img.round) { aspect-ratio: 1; border-radius: 50%; }
  .hd__pop :global(.opt-t) { font: 500 15px/1.25 var(--f-serif); }
  .hd__pop :global(.opt-s) { font: 400 12px/1.3 var(--f-sans); color: var(--c-graphite); }
  .hd__pop :global(mark) { background: #F1DDD3; color: inherit; padding: 0 1px; }
  .hd__pop :global(.empty) { padding: 12px 16px; font: 400 14px/1.4 var(--f-sans); color: var(--c-graphite); }
  .hd__all { display: block; border-top: var(--rule); margin-top: var(--s-2); padding: 12px 16px 6px; font: 600 var(--t-small)/1 var(--f-sans); color: var(--c-seal); text-decoration: none; }
  .hd__menu { display: none; }
  @media (max-width: 860px) {
    .hd__in { flex-wrap: wrap; gap: var(--s-3) var(--s-4); padding-block: var(--s-3); }
    .hd__menu { display: inline-flex; align-items: center; gap: 8px; margin-left: auto; min-height: 44px; padding: 0 12px; background: none; border: 1.5px solid var(--c-control); border-radius: var(--radius); font: 500 var(--t-small)/1 var(--f-sans); cursor: pointer; }
    .hd__burger, .hd__burger::before, .hd__burger::after { display: block; width: 16px; height: 2px; background: currentColor; position: relative; }
    .hd__burger::before, .hd__burger::after { content: ""; position: absolute; left: 0; }
    .hd__burger::before { top: -5px; } .hd__burger::after { top: 5px; }
    .hd__nav { order: 3; width: 100%; display: none; }
    :global(.menu-open) .hd__nav { display: block; }
    .hd__nav ul { flex-direction: column; gap: 0; border-top: var(--rule); }
    .hd__nav a { display: block; padding: 14px 0; border-bottom: var(--rule); font-size: 1.0625rem; }
    .hd__nav a[aria-current="page"] { color: var(--c-seal); border-bottom-color: var(--c-margin); }
    .hd__search { order: 4; width: 100%; margin-left: 0; }
  }
</style>
